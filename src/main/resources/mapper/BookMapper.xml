<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.BookMapper">

    <!--
        <sql> 片段：count 和 selectPage 共用同一段 WHERE，保证"总条数"和"当前页数据"的筛选条件永远一致。
        <where> 标签：里面一个条件都不成立时不输出 WHERE；成立时自动去掉开头多余的 AND。
        LIKE 用 CONCAT('%', #{title}, '%') 而不是 '%${title}%'：
            #{} 是预编译占位符（?），参数当字符串处理，防 SQL 注入；
            ${} 是字符串直接拼接，用户输入 ' OR '1'='1 就能改写 SQL。
    -->
    <sql id="pageWhere">
        <where>
            <if test="title != null and title != ''">
                AND b.title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="categoryId != null">
                AND b.category_id = #{categoryId}
            </if>
        </where>
    </sql>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM book b
        <include refid="pageWhere"/>
    </select>

    <!-- LEFT JOIN：即使分类被误删，图书也照样能查出来（categoryName 为 null），INNER JOIN 则会把它"吞掉" -->
    <select id="selectPage" resultType="BookVO">
        SELECT b.id, b.isbn, b.title, b.author, b.category_id, c.name AS category_name,
               b.total_stock, b.available_stock, b.create_time
        FROM book b
        LEFT JOIN category c ON b.category_id = c.id
        <include refid="pageWhere"/>
        ORDER BY b.id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="selectById" resultType="Book">
        SELECT * FROM book WHERE id = #{id}
    </select>

    <select id="selectByIsbn" resultType="Book">
        SELECT * FROM book WHERE isbn = #{isbn}
    </select>

    <select id="countByCategoryId" resultType="long">
        SELECT COUNT(*) FROM book WHERE category_id = #{categoryId}
    </select>

    <!-- 新书入库：可借数量 = 馆藏总量 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book (isbn, title, author, category_id, total_stock, available_stock)
        VALUES (#{isbn}, #{title}, #{author}, #{categoryId}, #{totalStock}, #{totalStock})
    </insert>

    <!--
        修改馆藏总量时，可借数量要跟着变化同样的差值：
            新可借 = 旧可借 + (新总量 - 旧总量)
        例：总量 3、借出 2（可借 1），改总量为 1 → 新可借 = 1 + (1-3) = -1，说明还有书在外面没还，不允许。
        把计算和判断放进同一条 UPDATE，由数据库行锁保证原子性；返回 0 行即"改不了"。

        坑：MySQL 的单表 UPDATE 按 SET 从左到右执行，右边的表达式会读到左边刚改过的值。
        所以 available_stock 必须写在 total_stock 前面，否则 (#{totalStock} - total_stock) 永远是 0。
    -->
    <update id="update">
        UPDATE book
        SET available_stock = available_stock + (#{totalStock} - total_stock),
            total_stock     = #{totalStock},
            isbn            = #{isbn},
            title           = #{title},
            author          = #{author},
            category_id     = #{categoryId}
        WHERE id = #{id}
          AND available_stock + (#{totalStock} - total_stock) &gt;= 0
    </update>

    <delete id="deleteById">
        DELETE FROM book WHERE id = #{id}
    </delete>

    <!--
        并发借书的核心：两个人同时借最后一本。
        错误做法：先 SELECT 查到 available_stock=1，Java 里判断 >0，再 UPDATE SET available_stock=0。
                  两个请求都查到 1、都判断通过、都更新 → 借出 2 本，库存却只少 1（超借）。
        正确做法：把"判断"写进 UPDATE 的 WHERE。InnoDB 更新时对该行加排他锁，第二个请求等锁，
                  拿到锁后重新判断 available_stock > 0 已不成立 → 影响 0 行 → Service 据此报"库存不足"。
    -->
    <update id="decreaseStock">
        UPDATE book SET available_stock = available_stock - 1
        WHERE id = #{id} AND available_stock &gt; 0
    </update>

    <!-- 还书：可借数量不能超过馆藏总量（防止重复还书把库存加爆） -->
    <update id="increaseStock">
        UPDATE book SET available_stock = available_stock + 1
        WHERE id = #{id} AND available_stock &lt; total_stock
    </update>
</mapper>
